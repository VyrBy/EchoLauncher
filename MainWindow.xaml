<Window x:Class="EchoLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoLauncher" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">

    <Window.Resources>
        <!-- Цветовая схема - используем SolidColorBrush -->
        <SolidColorBrush x:Key="PrimaryGreenBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="DarkGreenBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="LightGreenBrush" Color="#FF2E8B2E"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF20B020"/>

        <!-- Стиль для ComboBox -->
        <Style x:Key="GreenComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#141C17"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Стиль для элементов ComboBox -->
        <Style x:Key="GreenComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkGreenBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стили для вкладки сборок -->
        <Style x:Key="GreenListView" TargetType="ListView">
            <Setter Property="Background" Value="#FF252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
        </Style>

        <Style x:Key="GreenGridViewColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkGreenBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="GreenListViewItem" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#141C17"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{StaticResource DarkGreenBrush}" Height="60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="EchoLauncher" Foreground="White" 
                          FontSize="20" FontWeight="Bold" 
                          VerticalAlignment="Center" Margin="20,0"/>

                <!-- Панель авторизации -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock x:Name="AuthStatusText" Text="Не авторизован" 
                              Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="LoginButton" Content="Войти" 
                           Click="LoginButton_Click" Background="{StaticResource DarkGreenBrush}"
                           Foreground="White" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая панель -->
            <StackPanel Grid.Column="0" Background="#141C17">
                <Button x:Name="LaunchTabButton" Content="🚀 Запуск" Height="40" Margin="10,5" 
                        Click="LaunchTabButton_Click" Background="Transparent" 
                        Foreground="White" BorderThickness="0"/>
                <Button x:Name="BuildsTabButton" Content="📦 Сборки" Height="40" Margin="10,5"
                        Click="BuildsTabButton_Click" Background="Transparent"
                        Foreground="White" BorderThickness="0"/>
                <Button x:Name="ModsTabButton" Content="🔨 Моды" Height="40" Margin="10,5"
                        Click="ModsTabButton_Click" Background="Transparent" 
                        Foreground="White" BorderThickness="0"/>
                <Button x:Name="SettingsTabButton" Content="⚙ Настройки" Height="40" Margin="10,5"
                        Click="SettingsTabButton_Click" Background="Transparent" 
                        Foreground="White" BorderThickness="0"/>
                <Button x:Name="InfoTabButton" Content="ℹ О лаунчере" Height="40" Margin="10,5"
                        Click="InfoTabButton_Click" Background="Transparent" 
                        Foreground="White" BorderThickness="0"/>
            </StackPanel>

            <!-- Область контента -->
            <Border Grid.Column="1" Background="#101414" Padding="20">
                <Grid>
                    <!-- Вкладка Запуск -->
                    <StackPanel x:Name="LaunchTab" Visibility="Visible">
                        <TextBlock Text="Добро пожаловать в EchoLauncher!" 
                                  Foreground="White" FontSize="18" Margin="0,0,0,20"/>

                        <TextBlock Text="Выберите сборку:" Foreground="White" Margin="0,0,0,5"/>
                        <ComboBox x:Name="BuildsComboBox" 
                                 Style="{StaticResource GreenComboBox}"
                                 ItemContainerStyle="{StaticResource GreenComboBoxItem}"/>

                        <!-- Кнопка запуска -->
                        <Button Content="🎮 Запустить Minecraft" 
                               Height="40" Width="220" Background="{StaticResource PrimaryGreenBrush}" 
                               Foreground="White" FontWeight="Bold" FontSize="14"
                               Click="LaunchButton_Click" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Вкладка Сборки -->
                    <Grid x:Name="BuildsTab" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок и кнопка добавления -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Сборки Minecraft" Foreground="White"
                                      FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <!-- Кнопка добавления -->
                            <Button Content="➕ Новая сборка" Margin="20,0,0,0"
                                   Click="AddBuildButton_Click" Background="{StaticResource PrimaryGreenBrush}"
                                   Foreground="White" Padding="10,5"/>
                        </StackPanel>

                        <!-- Список сборок -->
                        <ListView x:Name="BuildsListView" Grid.Row="1"
                                 Style="{StaticResource GreenListView}"
                                 ItemContainerStyle="{StaticResource GreenListViewItem}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Название" Width="150" DisplayMemberBinding="{Binding Name}">
                                        <GridViewColumn.HeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GreenGridViewColumnHeader}"/>
                                        </GridViewColumn.HeaderContainerStyle>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Версия" Width="100" DisplayMemberBinding="{Binding Version}">
                                        <GridViewColumn.HeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GreenGridViewColumnHeader}"/>
                                        </GridViewColumn.HeaderContainerStyle>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Тип" Width="100" DisplayMemberBinding="{Binding Type}">
                                        <GridViewColumn.HeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GreenGridViewColumnHeader}"/>
                                        </GridViewColumn.HeaderContainerStyle>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Создана" Width="120" DisplayMemberBinding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}">
                                        <GridViewColumn.HeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GreenGridViewColumnHeader}"/>
                                        </GridViewColumn.HeaderContainerStyle>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Кнопки управления -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <Button Content="🗑️ Удалить" Click="DeleteBuildButton_Click"
                                   Background="#FFD13438" Foreground="White" Padding="10,5" Margin="0,0,10,0"/>
                            <!-- Кнопка открытия папки -->
                            <Button Content="📂 Открыть папку" Click="OpenFolderButton_Click"
                                   Background="{StaticResource PrimaryGreenBrush}" Foreground="White" Padding="10,5" Margin="0,0,10,0"/>
                            <Button Content="🔄 Обновить" Click="RefreshBuildsButton_Click"
                                   Background="{StaticResource PrimaryGreenBrush}" Foreground="White" Padding="10,5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Вкладка Моды -->
                    <StackPanel x:Name="ModsTab" Visibility="Collapsed">
                        <TextBlock Text="Система модов в разработке" 
                                  Foreground="White" FontSize="18" Margin="0,0,0,20"/>
                        <TextBlock Text="Скоро здесь появится управление модами!" 
                                  Foreground="LightGray" FontSize="14"/>
                    </StackPanel>

                    <!-- Вкладка Настройки -->
                    <StackPanel x:Name="SettingsTab" Visibility="Collapsed">
                        <TextBlock Text="Настройки в разработке" 
                                  Foreground="White" FontSize="18" Margin="0,0,0,20"/>
                        <TextBlock Text="Скоро здесь появится управление лаунчером!" 
                                  Foreground="LightGray" FontSize="14"/>    
                    </StackPanel>

                    <!-- Вкладка О лаунчере -->
                    <StackPanel x:Name="InfoTab" Visibility="Collapsed">
                        <TextBlock Text="Здесь будет информация о лаунчере..." 
              Foreground="White" FontSize="18" Margin="0,0,0,20"/>
                        <TextBlock Text="Пока что здесь ничего нет." 
              Foreground="LightGray" FontSize="14"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <!-- Статус-бар -->
        <StatusBar Grid.Row="2" Background="{StaticResource DarkGreenBrush}" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов к работе"/>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="ProgressBar" Width="150" Height="10"
                     Minimum="0" Maximum="100" Value="0"
                     Background="#FF2A2A2A"
                     Margin="0,0,10,0">
                    <ProgressBar.Foreground>
                        <SolidColorBrush Color="#FF2E8B2E"/>
                    </ProgressBar.Foreground>
                </ProgressBar>
            </StatusBarItem>
        </StatusBar>


    </Grid>
</Window>